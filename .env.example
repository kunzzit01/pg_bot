# 复制为 .env 后填真实值（.env 已被 .gitignore 忽略，也不要提交到 git）
# BotFather 那里拿到的 token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据目录
# - Docker 部署：不用改。镜像里默认 /app/data，正好对应 -v 挂进来的仓库目录 data/
# - 本地跑：取消下面这行的注释，数据会落在当前目录的 data/
# BOT_DATA_DIR=./data

# ---------- 账单明细网页（可选，不填就不开）----------
# 网页跑在 bot 进程里（同目录 webconsole.py），下面几个要一起设才通：
#   WEB_CONSOLE_SECRET      不设 = 网页不启动、「📋 账单明细」按钮也不显示
#   WEB_CONSOLE_PORT        容器内网页端口（默认 8787，一般不用改）
#   WEB_CONSOLE_BIND        容器里必须绑 0.0.0.0；绑 127.0.0.1 的话容器外连不上
#   WEB_CONSOLE_HOST_PORT   宿主机对外端口，deploy/update.sh 会映射 它 -> WEB_CONSOLE_PORT
#   WEB_CONSOLE_BASE_URL    「📋 账单明细」按钮跳转的网址前缀（不填按钮就不显示）
#
# 本机的实际布置（8787 已被 ledgerbot_container 占用，所以用 8989）：
#   Cloudflare 子域名 --回源--> 宿主机 8989 --docker -p--> 容器 8787
# WEB_CONSOLE_SECRET=
# WEB_CONSOLE_PORT=8787
# WEB_CONSOLE_BIND=0.0.0.0
# WEB_CONSOLE_HOST_PORT=8989
# WEB_CONSOLE_BASE_URL=https://你的子域名

# 不想走域名、直接用 IP 也行（把 BASE_URL 换成 IP:宿主机端口）：
# WEB_CONSOLE_BASE_URL=http://187.127.125.136:8989

# 只读网页（不启动内嵌控制台时用；配了这个但没配 SECRET，按钮会指向一个不存在的页面）
# LEDGER_DETAIL_BASE_URL=https://你的域名/ledger

# ---------- 可选 ----------
# TRON 地址余额查询用的 API Key（不填用代码里的默认值）
# TRON_API_KEY=
