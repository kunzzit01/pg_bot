# 复制为 .env 后填真实值（.env 已被 .gitignore 忽略，也不要提交到 git）
# BotFather 那里拿到的 token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据目录
# - Docker 部署：不用改。镜像里默认 /app/data，正好对应 -v 挂进来的仓库目录 data/
# - 本地跑：取消下面这行的注释，数据会落在当前目录的 data/
# BOT_DATA_DIR=./data

# ---------- 账单明细网页（可选，不填就不开）----------
# 网页跑在 bot 进程里，默认绑 127.0.0.1:8787
# 容器部署想从外面打开，必须三个一起设：
#   WEB_CONSOLE_PORT=8787
#   WEB_CONSOLE_BIND=0.0.0.0
#   然后用 PORT=8787 bash deploy/update.sh 把端口映射出来
# WEB_CONSOLE_PORT=8787
# WEB_CONSOLE_BIND=0.0.0.0

# 「📋 账单明细」按钮跳转的网址前缀，不填就不显示这个按钮
# LEDGER_DETAIL_BASE_URL=https://pg.count168.site/ledger

# 网页访问密钥（不填则自动生成/不带密钥）
# WEB_CONSOLE_SECRET=换成你自己的长口令

# ---------- 可选 ----------
# TRON 地址余额查询用的 API Key（不填用代码里的默认值）
# TRON_API_KEY=
